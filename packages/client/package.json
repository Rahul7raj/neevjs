{
  "name": "@neevjs/client",
  "version": "0.1.0-beta",
  "description": "NeevJS core React framework — plugin-driven, offline-first, built for business apps",
  "keywords": [
    "react",
    "framework",
    "crud",
    "business",
    "offline-first",
    "plugin",
    "neevjs"
  ],
  "author": "Rahul Raj Kushwaha <rahulkraj.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rahulkraj/neevjs"
  },
  "source": "src/index.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@neevjs/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "react": "^19.2.5",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
