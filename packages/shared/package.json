{
  "name": "@neevjs/shared",
  "version": "1.0.1-beta",
  "description": "Shared types and utilities for NeevJS",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahul7raj/neevjs.git"
  },
  "bugs": {
    "url": "https://github.com/rahul7raj/neevjs/issues"
  },
  "homepage": "https://rahul7raj.github.io/neevjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
